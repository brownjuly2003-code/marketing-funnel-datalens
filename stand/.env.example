# Template for stand/.env. run.sh creates stand/.env with random values when it is missing.
# Values below are placeholders, not working secrets.
POSTGRES_PASSWORD=change-me-32-alphanumeric-chars
US_MASTER_TOKEN=change-me-32-alphanumeric-chars
AUTH_MASTER_TOKEN=change-me-32-alphanumeric-chars
# Base64 of 32 random characters, as the release init.sh generates it.
CONTROL_API_CRYPTO_KEY=change-me-base64
CLICKHOUSE_DATALENS_PASSWORD=change-me-32-alphanumeric-chars
